{
  "_readme": "Template for config.json. Copy to config.json and replace placeholders. Keys with leading _ are documentation only and ignored by the app.",
  "project_directory": "../ExampleProject",
  "git": false,
  "git_auto_commit": false,
  "default_iteration_minutes": 5,
  "min_iterations_before_complete": 3,
  "background_agents_enabled": true,
  "default_model": "gemini-2.5-pro",
  "cli_mode": {
    "mode": "semi_attended",
    "_mode_options": [
      "interactive",
      "semi_attended",
      "unattended"
    ],
    "unattended": {
      "max_duration_hours": 1.5,
      "auto_continue": true,
      "checkpoint_interval_minutes": 15,
      "max_iterations_per_task": 15,
      "min_idle_minutes": 5.0,
      "auto_generate_tasks": true,
      "prioritize_critical_issues": true,
      "auto_init_on_start": true,
      "seed_task": "Build an example Python Shiny app (shiny package for Python) that helps display canned report images. Include: a small gallery or viewer for sample report image files, navigation between images, and clear README for how to run the app. Place the app files (e.g. app.py, README.md, requirements.txt) directly in the root of the project directory with sample placeholder images in assets/ or www/.",
      "seed_tasks": [
        "Add an interactive image zoom and pan feature to app.py for high-resolution canned report screenshots.",
        "Implement a metadata sidebar in app.py displaying report file size, last modified timestamp, and report category tags.",
        "Create a script generate_sample_reports.py under assets/ that programmatically generates 3 sample synthetic report charts (sales, traffic, latency) using matplotlib or pillow.",
        "Add export functionality to app.py allowing users to download selected report images as a zip archive.",
        "Create comprehensive unit and integration tests in tests/test_app.py validating Shiny app reactive outputs and file gallery indexing."
      ],
      "stop_when_backlog_empty": false,
      "exit_on_preflight_failure": true
    }
  },
  "endpoints": {
    "gemini": {
      "base_url": "https://example.com/v1/chat/completions",
      "api_key_name": "gemini_api_key",
      "key_management_url": "https://genai.mil/stark/user-ui/keys",
      "include_model_in_payload": true,
      "response_path": [
        "choices",
        0,
        "message",
        "content"
      ],
      "description": "Enterprise Gemini-compatible OpenAI-style endpoint",
      "priority": 20,
      "rate_limit_per_minute": 118
    },
    "databricks": {
      "base_url": "https://databricks.example.com/serving-endpoints/claude-sonnet/invocations",
      "api_key_name": "databricks_token",
      "key_management_url": "https://docs.databricks.com/en/dev-tools/auth/pat.html",
      "include_model_in_payload": false,
      "response_path": [
        "choices",
        0,
        "message",
        "content"
      ],
      "description": "Enterprise Databricks endpoint",
      "priority": 10,
      "rate_limit_per_minute": 60
    }
  },
  "default_endpoint": "gemini",
  "fallback_settings": {
    "enabled": false,
    "max_fallback_attempts": 2,
    "cooldown_on_exhaustion_minutes": 5,
    "cooldown_on_lock_minutes": 1,
    "cooldown_on_rate_limit_minutes": 1,
    "cooldown_on_error_minutes": 5,
    "prefer_same_provider": false,
    "log_fallbacks": true
  },
  "models": {
    "gemini-3.1-pro-preview": {
      "endpoint": "gemini",
      "max_output_tokens": 16384,
      "temperature": 0.5,
      "max_context_tokens": 1000000,
      "description": "Most capable Gemini, best for complex reasoning"
    },
    "gemini-2.5-pro": {
      "endpoint": "gemini",
      "max_output_tokens": 16384,
      "temperature": 0.5,
      "description": "Strong reasoning, good balance"
    },
    "gemini-3-flash-preview": {
      "endpoint": "gemini",
      "max_output_tokens": 16384,
      "temperature": 0.7,
      "description": "Fast and cost-effective"
    },
    "databricks-claude-sonnet-4-5": {
      "endpoint": "databricks",
      "max_output_tokens": 16384,
      "temperature": 0.5,
      "description": "Claude Sonnet via Databricks"
    }
  },
  "agent_model_preferences": {
    "orchestrator": "gemini-3.1-pro-preview",
    "developer": "gemini-3.1-pro-preview",
    "reviewer": "gemini-3.1-pro-preview",
    "researcher": "gemini-3-flash-preview",
    "prioritizer": "gemini-3.1-pro-preview",
    "jr_reviewer": "gemini-3-flash-preview",
    "jr_researcher": "gemini-3-flash-preview",
    "tech_writer": "gemini-3-flash-preview",
    "file_manager": "gemini-3.1-pro-preview",
    "archivist": "gemini-3.1-pro-preview",
    "project_reporter": "gemini-3-flash-preview",
    "resource_controller": "gemini-3.1-pro-preview",
    "deployment_validator": "gemini-3.1-pro-preview",
    "security_reviewer": "gemini-3-flash-preview"
  },
  "proxy": {
    "http": "",
    "https": "",
    "_note": "Leave empty strings to disable. Example: http://proxy.example.com:8080"
  },
  "token_budget": {
    "max_tokens_per_4h": 250000
  },
  "reporter": {
    "enabled": true,
    "interval_minutes": 10,
    "change_threshold_percent": 5.0,
    "change_threshold_lines": 2000,
    "include_git_commits": true,
    "include_agent_activity": true,
    "max_reports_to_keep": 3000,
    "report_trigger_cooldown_minutes": 5
  },
  "resource_controller": {
    "enabled": true,
    "check_interval_seconds": 5,
    "max_tokens_per_day": 50000000,
    "aggressive_throttling_threshold": 0.75,
    "project_goals": {
      "max_daily_cost_usd": 200,
      "priority_focus": [
        "security",
        "performance"
      ],
      "human_only_adjust": true,
      "notes": "ONLY HUMANS may edit this section. Agents must treat it as immutable."
    }
  },
  "background_agents": {
    "jr_reviewer": {
      "enabled": true,
      "on_modification": true,
      "random_review": true,
      "random_files_per_cycle": 3
    },
    "jr_researcher": {
      "enabled": true,
      "on_modification": false,
      "random_review": true,
      "random_files_per_cycle": 2
    },
    "tech_writer": {
      "enabled": true,
      "on_modification": false,
      "random_review": true,
      "random_files_per_cycle": 2
    },
    "security_reviewer": {
      "enabled": true,
      "on_modification": true,
      "random_review": true,
      "random_files_per_cycle": 2
    },
    "deployment_validator": {
      "enabled": true,
      "on_modification": true,
      "random_review": false,
      "confidence_threshold": 0.7
    }
  },
  "background_feeder": {
    "interval_seconds": 30,
    "files_per_agent_default": 3
  },
  "file_operations": {
    "max_file_size_kb": 1000,
    "ignore_patterns": [
      "*.pyc",
      "__pycache__",
      ".git",
      "node_modules",
      ".env",
      "*.db",
      "venv",
      ".venv",
      ".PrizmForge"
    ]
  },
  "file_editing": {
    "method": "full_replace",
    "_method_options": [
      "guid",
      "find_replace",
      "full_replace",
      "diff"
    ],
    "_note": "method is a soft legacy preference. preferred_modes + fallback_order drive selection.",
    "preferred_modes": [
      "guid",
      "find_replace",
      "full_replace"
    ],
    "fallback_order": [
      "guid",
      "diff",
      "find_replace",
      "full_replace"
    ],
    "small_file_threshold_lines": 180
  },
  "feedback": {
    "max_age_days_low": 7,
    "max_unaddressed": 200,
    "_note": "Backlog aging for unattended runs"
  },
  "content_safety": {
    "disallow_binary_content": true,
    "blocked_extensions": [
      ".appx",
      ".appxbundle",
      ".bin",
      ".cab",
      ".com",
      ".cpl",
      ".dll",
      ".dmg",
      ".drv",
      ".exe",
      ".img",
      ".iso",
      ".msi",
      ".msix",
      ".msm",
      ".msp",
      ".msu",
      ".ocx",
      ".scr",
      ".sys"
    ]
  },
  "llm": {
    "test_mode": false,
    "mock_responses": {},
    "_note": "Set test_mode true or PRIZMFORGE_TEST_MODE=1 to skip real API calls."
  }
}
