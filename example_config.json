{
  "_readme": "Template for config.json. Copy this file and fill in your values. Keys starting with _ are for documentation only.",

  "project_directory": "../ExampleProject",
  "git": false,
  "git_auto_commit": false,

  "default_iteration_minutes": 5,
  "min_iterations_before_complete": 3,
  "background_agents_enabled": true,

  "default_model": "gemini/gemini-3.1-pro-preview",

  "cli_mode": {
    "mode": "unattended",
    "unattended": {
      "max_duration_hours": 2,
      "auto_continue": true,
      "checkpoint_interval_minutes": 15,
      "max_iterations_per_task": 30,
      "auto_generate_tasks": true,
      "stop_when_backlog_empty": true
    }
  },

  "endpoints": {
    "gemini": {
      "base_url": "https://api.genai.mil/v1/chat/completions",
      "api_key_name": "gemini_api_key",
      "include_model_in_payload": true,
      "response_path": ["choices", 0, "message", "content"],
      "description": "Primary Gemini endpoint",
      "priority": 10,
      "rate_limit_per_minute": 100,
      "models": {
        "gemini-3.7-flash": {
          "max_output_tokens": 65536,
          "max_context_tokens": 1048576,
          "temperature": 0.7,
          "description": "Fast default model"
        },
        "gemini-3.1-pro-preview": {
          "max_output_tokens": 65536,
          "max_context_tokens": 1048576,
          "temperature": 0.5,
          "description": "Higher capability model"
        }
      }
    },
    "beta_genai": {
      "base_url": "https://api-beta.genai.mil/v1/chat/completions",
      "api_key_name": "beta_genai_api_key",
      "include_model_in_payload": true,
      "response_path": ["choices", 0, "message", "content"],
      "description": "Beta endpoint for future models (Grok, GPT, etc.)",
      "priority": 20,
      "rate_limit_per_minute": 80,
      "models": {
        "grok-4.3-fast": {
          "max_output_tokens": 32768,
          "max_context_tokens": 128000,
          "temperature": 0.7,
          "description": "Fast Grok model (placeholder)"
        },
        "gpt-5.4": {
          "max_output_tokens": 65536,
          "max_context_tokens": 200000,
          "temperature": 0.6,
          "description": "GPT model (placeholder)"
        }
      }
    }
  },

  "default_endpoint": "gemini",

  "fallback_settings": {
    "enabled": true,
    "max_fallback_attempts": 2
  },

  "agent_model_preferences": {
    "orchestrator": "gemini/gemini-3.1-pro-preview",
    "developer": "gemini/gemini-3.1-pro-preview",
    "reviewer": "gemini/gemini-3.1-pro-preview",
    "researcher": "gemini/gemini-3.1-pro-preview",
    "prioritizer": "gemini/gemini-3.1-pro-preview",
    "security_reviewer": "gemini/gemini-3.1-pro-preview",
    "deployment_validator": "gemini/gemini-3.1-pro-preview",

    "jr_reviewer": "gemini/gemini-3.7-flash",
    "jr_researcher": "gemini/gemini-3.7-flash",
    "tech_writer": "gemini/gemini-3.7-flash",
    "file_manager": "gemini/gemini-3.7-flash",
    "archivist": "gemini/gemini-3.7-flash",
    "project_reporter": "gemini/gemini-3.7-flash",
    "resource_controller": "gemini/gemini-3.7-flash"
  },

  "proxy": {
    "http": "",
    "https": "",
    "_note": "Leave empty to disable proxy"
  },

  "token_budget": {
    "max_tokens_per_4h": 500000
  },

  "reporter": {
    "enabled": true,
    "interval_minutes": 10
  },

  "resource_controller": {
    "enabled": true,
    "max_tokens_per_day": 2000000,
    "model_downgrades": {
      "default_model": "gemini/gemini-3.7-flash",
      "critical": {
        "orchestrator": "gemini/gemini-3.1-pro-preview",
        "developer": "gemini/gemini-3.1-pro-preview",
        "prioritizer": "gemini/gemini-3.1-pro-preview",
        "security_reviewer": "gemini/gemini-3.1-pro-preview"
      },
      "aggressive": {
        "jr_reviewer": "gemini/gemini-3.7-flash",
        "jr_researcher": "gemini/gemini-3.7-flash",
        "tech_writer": "gemini/gemini-3.7-flash"
      }
    }
  },

  "background_agents": {
    "jr_reviewer": {
      "enabled": true,
      "on_modification": true,
      "random_review": true
    },
    "security_reviewer": {
      "enabled": true,
      "on_modification": true
    }
  },

  "file_editing": {
    "preferred_modes": ["guid", "find_replace", "full_replace"],
    "fallback_order": ["guid", "diff", "find_replace", "full_replace"],
    "small_file_threshold_lines": 180
  },

  "content_safety": {
    "disallow_binary_content": true,
    "blocked_extensions": [
      ".exe", ".dll", ".bin", ".iso", ".msi", ".dmg", ".appx"
    ]
  },

  "llm": {
    "test_mode": false,
    "_note": "Set to true or use PRIZMFORGE_TEST_MODE=1 to disable real API calls"
  }
}
